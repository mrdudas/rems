  :email {:reviewer-message {:signature "\n\n%1\nEgyesített Pszichológiai Kutatásetikai Bizottság (EPKEB)"}
          :changes-due-soon {:subject "(%:application-id%) A módosítás határideje: %:deadline%"
                             :message "Tisztelt %:recipient%!\n\nEmlékeztetjük, hogy a(z) %:application-id% kérelem módosításának beküldési határideje %:deadline%, még %:days% nap van hátra. A határidő elmulasztása az eljárás felfüggesztését vonja maga után.\n\nA kérelem: %:application-url%"}
          :changes-overdue {:subject "(%:application-id%) Lejárt a módosítás határideje"
                            :message "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelem módosításának beküldési határideje %:deadline% volt. Az eljárásrend szerint az eljárás felfüggesztésre kerül; erről az elnök dönt.\n\nA kérelem: %:application-url%"
                            :subject-to-handler "(%:application-id%) Lejárt a módosítás határideje"
                            :message-to-handler "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelem módosításának beküldési határideje %:deadline% volt, a kérelmező nem küldte be. Az eljárás felfüggeszthető (a kérelem lezárása).\n\nA kérelem: %:application-url%"}
          :review-due-soon {:subject "EPKEB-kérelem %:application-id% – emlékeztető"
                            :message "Kedves %:recipient%!\n\nEz egy emlékeztető levél: a(z) %:application-id% kérelem bírálati határideje %:deadline% (még %:days% nap).\n\nKérlek, add le a bírálatot: %:application-url%"}
          :review-overdue {:subject "EPKEB-kérelem %:application-id% – határidőn túli emlékeztető"
                           :message "Kedves %:recipient%!\n\nEz egy emlékeztető levél: a(z) %:application-id% kérelem bírálati határideje %:deadline% napon lejárt.\n\nKérlek, amint időd engedi, add le a bírálatot, vagy jelezd az elnöknek, ha nem tudod vállalni: %:application-url%"
                           :subject-to-handler "EPKEB-kérelem %:application-id% – késik egy bírálat"
                           :message-to-handler "Kedves %:recipient%!\n\n%:reviewer% bírálata a(z) %:application-id% kérelemhez %:days% napja késik (határidő: %:deadline%); a bíráló emlékeztetőt kapott.\n\nA kérelem: %:application-url%"}
          :applicant-changed {:subject-to-member "A(z) %:application-id% kérelem kapcsolattartója megváltozott"
                              :message-to-member "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelem kapcsolattartóját %:event-actor% megváltoztatta a következőre: %:applicant%.\n\nA kérelmet itt tekintheti meg: %:application-url%."
                              :subject-to-handler "(%:application-id%) Kapcsolattartó megváltozott"
                              :message-to-handler "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelem kapcsolattartóját %:event-actor% megváltoztatta a következőre: %:applicant%.\n\nA kérelmet itt tekintheti meg: %:application-url%."}
          :application-approved {:subject-to-applicant "EPKEB-kérelem %:application-id% – engedély"
                                 :message-to-applicant "Kedves %:recipient%!\n\nÖrömmel értesítjük, hogy a(z) %:application-id% kérelmet az EPKEB jóváhagyta, az engedély kiadható.\n\nSok sikert kívánunk a kutatáshoz!\n\nA kérelem és a döntés: %:application-url%"
                                 :subject-to-handler "(%:application-id%) A kérelmet jóváhagyták"
                                 :message-to-handler "Tisztelt %:recipient%!\n\n%:event-actor% jóváhagyta %:applicant% %:application-id% azonosítójú kérelmét.\n\nA kérelmet és a döntést itt tekintheti meg: %:application-url%"
                                 :subject-to-reviewer "EPKEB-kérelem %:application-id% – lezárult"
                                 :message-to-reviewer "Kedves %:recipient%!\n\nSzeretnélek tájékoztatni, hogy az általad bírált %:application-id% kérelem engedélyezési folyamata sikeresen lezárult, a kérelmet az EPKEB jóváhagyta.\n\nKöszönjük a bírálatot!"
                                 :message-to-applicant-with-permit "Kedves %:recipient%!\n\nÖrömmel értesítjük, hogy a(z) %:application-id% kérelmet az EPKEB jóváhagyta. Az engedély száma: %:permit-number%.\n\nAz engedély itt tekinthető meg és tölthető le PDF-ben; ezt a linket megoszthatja azokkal (például folyóirattal, finanszírozóval), akiknek igazolnia kell az engedélyt:\n%:permit-url%\n\nSok sikert kívánunk a kutatáshoz!\n\nA kérelem: %:application-url%"}
          :application-rejected {:subject-to-applicant "A(z) %:application-id% kérelmét elutasították"
                                 :message-to-applicant "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelmét elutasították.\n\nA kérelmet és a döntést itt tekintheti meg: %:application-url%"
                                 :subject-to-handler "(%:application-id%) A kérelmet elutasították"
                                 :message-to-handler "Tisztelt %:recipient%!\n\n%:event-actor% elutasította %:applicant% %:application-id% azonosítójú kérelmét.\n\nA kérelmet és a döntést itt tekintheti meg: %:application-url%"}
          :application-closed {:subject-to-applicant "A(z) %:application-id% kérelmét lezárták"
                               :message-to-applicant "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelmét lezárták.\n\nA kérelmet továbbra is megtekintheti itt: %:application-url%"
                               :subject-to-handler "(%:application-id%) A kérelmet lezárták"
                               :message-to-handler "Tisztelt %:recipient%!\n\n%:event-actor% lezárta %:applicant% %:application-id% azonosítójú kérelmét.\n\nA kérelmet itt tekintheti meg: %:application-url%"}
