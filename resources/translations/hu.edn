          :application-resubmitted {:subject-to-handler "EPKEB-kérelem %:application-id% – beérkezett a módosítás"
                                    :message-to-handler "Kedves %:recipient%!\n\nBeérkezett a(z) %:application-id% kérelem módosítása. Kérd fel újra a bírálókat (10 napos határidővel), vagy dönts.\n\nA kérelem: %:application-url%"}
          :application-submitted {:subject-to-applicant "EPKEB-kérelem %:application-id% – benyújtva"
                                  :message-to-applicant "Kedves %:recipient%!\n\nA(z) %:application-id% kérelmet benyújtották az EPKEB-hez. A bírálat eredményéről e-mailben értesítjük.\n\nA kérelem: %:application-url%"
