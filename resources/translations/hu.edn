          :application-returned {:subject-to-applicant "EPKEB-kérelem %:application-id% – bírálói visszajelzések"
                                 :message-to-applicant "Kedves %:recipient%!\n\nBeérkeztek a kérelméhez tartozó bírálatok, és a kérelmet módosításra visszaküldtük. Az észrevételek:\n\n%:comment%\n\nA módosított válaszokat a rendszer a bírálóknak kiemeli; a mellékletekben kérjük, a módosításokat jól látható módon (színes kijelöléssel és/vagy félkövér betűtípussal) jelölje.\n\nA módosított kérelem beküldésére 30 nap áll rendelkezésére. A határidő (%:deadline%) elmulasztása az eljárás felfüggesztését vonja maga után. A kérelmezőnek joga van a módosított kérelemmel új eljárást kezdeményezni, ám ebben az esetben új bírálók kerülnek kijelölésre, akiknek ismételten 20 nap áll rendelkezésére a kérelem elbírálására.\n\nA kérelmet itt módosíthatja: %:application-url%"
                                 :subject-to-handler "EPKEB-kérelem %:application-id% – módosításra visszaküldve"
                                 :message-to-handler "Kedves %:recipient%!\n\n%:event-actor% módosításra visszaküldte a(z) %:application-id% kérelmet. A beküldési határidő %:deadline%.\n\nA kérelem: %:application-url%"
                                 :subject-to-reviewer "EPKEB-kérelem %:application-id% – bírálói visszajelzések"
                                 :message-to-reviewer "Kedves %:recipient%!\n\nTájékoztatásul: a(z) %:application-id% kérelmet a bírálatok alapján módosításra visszaküldtük. A kérelmezőnek küldött észrevételek:\n\n%:comment%\n\nA beérkező módosításról újabb felkérést kapsz. A kérelem: %:application-url%"}
          :application-revoked {:subject-to-applicant "A(z) %:application-id% kérelem engedélyét visszavonták"
                                :message-to-applicant "Tisztelt %:recipient%!\n\nA(z) %:application-id% kérelem engedélyét visszavonták.\n\nA kérelmet itt tekintheti meg: %:application-url%"
                                :subject-to-handler "(%:application-id%) Az engedélyt visszavonták"
                                :message-to-handler "Tisztelt %:recipient%!\n\n%:event-actor% visszavonta a(z) %:application-id% kérelem engedélyét %:applicant% felhasználótól.\n\nA kérelmet itt tekintheti meg: %:application-url%"}
          :application-licenses-added {:subject "A(z) %:application-id% kérelem nyilatkozatai megváltoztak"
