  ;; Format parameters for all emails (unless otherwise noted):
  ;; %1 - %:recipient% - name of recipient
  ;; %2 - %:event-actor% - name of event actor
  ;; %3 - %:application-id% - id of application (+ description of application if available)
  ;; %4 - %:applicant% - name of applicant
  ;; %5 - %:catalogue-items% - catalogue items of application, comma separated list
  ;; %6 - %:application-url% - link to application
  ;;
  ;; Vector parameters (%1, %2, ...) in extra translations are supported for backwards compatibility.
  ;; They cannot be mixed with named format parameters, and have fixed positions.
  :email {:changes-due-soon {:subject "(%:application-id%) Deadline of the changes: %:deadline%"
                             :message "Dear %:recipient%,\n\nThis is a reminder that the deadline for submitting the changes to application %:application-id% is %:deadline%, %:days% days from now. Missing the deadline leads to the suspension of the procedure.\n\nThe application: %:application-url%"}
          :changes-overdue {:subject "(%:application-id%) The deadline of the changes has passed"
                            :message "Dear %:recipient%,\n\nThe deadline for submitting the changes to application %:application-id% was %:deadline%. According to the rules of procedure, the procedure is suspended; the chair decides about it.\n\nThe application: %:application-url%"
                            :subject-to-handler "(%:application-id%) The deadline of the changes has passed"
                            :message-to-handler "Dear %:recipient%,\n\nThe deadline for submitting the changes to application %:application-id% was %:deadline%, and the applicant has not submitted them. The procedure can be suspended (by closing the application).\n\nThe application: %:application-url%"}
          :review-due-soon {:subject "EPKEB application %:application-id% – reminder"
                            :message "Dear %:recipient%,\n\nThis is a reminder that the deadline of your review of application %:application-id% is %:deadline% (%:days% days from now).\n\nPlease submit your review: %:application-url%"}
          :review-overdue {:subject "EPKEB application %:application-id% – overdue reminder"
                           :message "Dear %:recipient%,\n\nThis is a reminder that the deadline of your review of application %:application-id% was %:deadline%.\n\nPlease submit your review as soon as you can, or let the chair know if you cannot: %:application-url%"
                           :subject-to-handler "EPKEB application %:application-id% – a review is overdue"
                           :message-to-handler "Dear %:recipient%,\n\nThe review of %:reviewer% for application %:application-id% is %:days% days overdue (deadline: %:deadline%); the reviewer has been reminded.\n\nThe application: %:application-url%"}
          :applicant-changed {:subject-to-member "Applicant for application %:application-id% changed"
                              :message-to-member "Dear %:recipient%,\n\nThe applicant for application %:application-id% has been changed to %:applicant% by %:event-actor%.\n\nYou can view the application at %:application-url%."
                              :subject-to-handler "(%:application-id%) Applicant changed"
                              :message-to-handler "Dear %:recipient%,\n\nThe applicant for application %:application-id% has been changed to %:applicant% by %:event-actor%.\n\nYou can view the application at %:application-url%."}
          :application-approved {:subject-to-applicant "EPKEB application %:application-id% – approval"
                                 :message-to-applicant "Dear %:recipient%,\n\nI am pleased to inform you that application %:application-id% has been approved by the EPKEB.\n\nWe wish you good luck with your research!\n\nThe application and the decision: %:application-url%"
                                 :subject-to-handler "(%:application-id%) Application has been approved"
                                 :message-to-handler "Dear %:recipient%,\n\n%:event-actor% has approved the application %:application-id% from %:applicant%.\n\nYou can view the application and the decision at %:application-url%"
                                 :subject-to-reviewer "EPKEB application %:application-id% – closed"
                                 :message-to-reviewer "Dear %:recipient%,\n\nI would like to inform you that the procedure of application %:application-id%, which you reviewed, has been closed successfully: the application has been approved by the EPKEB.\n\nThank you for your review!"
                                 :message-to-applicant-with-permit "Dear %:recipient%,\n\nI am pleased to inform you that application %:application-id% has been approved by the EPKEB. The reference number of the approval is %:permit-number%.\n\nThe approval can be viewed and downloaded as a PDF at the link below; you can share the link with anyone (e.g. a journal or a funder) who needs to verify the approval:\n%:permit-url%\n\nWe wish you good luck with your research!\n\nThe application: %:application-url%"}
          :application-rejected {:subject-to-applicant "Your application %:application-id% has been rejected"
                                 :message-to-applicant "Dear %:recipient%,\n\nYour application %:application-id% has been rejected.\n\nYou can view the application and the decision at %:application-url%"
                                 :subject-to-handler "(%:application-id%) Application has been rejected"
                                 :message-to-handler "Dear %:recipient%,\n\n%:event-actor% has rejected the application %:application-id% from %:applicant%.\n\nYou can view the application and the decision at %:application-url%"}
          :application-closed {:subject-to-applicant "Your application %:application-id% has been closed"
                               :message-to-applicant "Dear %:recipient%,\n\nYour application %:application-id% has been closed.\n\nYou can still view the application at %:application-url%"
                               :subject-to-handler "(%:application-id%) Application has been closed"
                               :message-to-handler "Dear %:recipient%,\n\n%:event-actor% has closed the application %:application-id% from %:applicant%.\n\nYou can view the application at %:application-url%"}
          ;; Format parameters for application-expiration-notification:
          ;; %1 - %:recipient% - name of recipient
          ;; %2 - %:application-id% - id of application (+ description of application if available)
          ;; %3 - %:last-activity% - date of last activity in application
          ;; %4 - %:expires-on% - date of application expiration (after which draft application will be removed)
          ;; %5 - %:application-url% - link to application
          :application-expiration-notification {:subject-to-member "Your unsubmitted application %:application-id% will be deleted soon"
                                                :message-to-member "Dear %:recipient%,\n\nYour unsubmitted application has been inactive since %:last-activity% and it will be deleted after %:expires-on%, if it is not edited.\n\nYou can view and edit the application at %:application-url%"}
          :application-returned {:subject-to-applicant "EPKEB application %:application-id% – feedback from reviewers"
                                 :message-to-applicant "Dear %:recipient%,\n\nThe reviews for your application have arrived, and the application has been returned for changes. The feedback:\n\n%:comment%\n\nThe system highlights the changed answers to the reviewers; in the attachments, please indicate the changes in a clearly visible way (in highlighted colour and/or bold font).\n\nPlease note that you have 30 days to submit the amended application. Failure to meet the deadline (%:deadline%) will result in suspension of the procedure. The applicant has the right to initiate a new procedure with the amended application, but in this case new reviewers will be appointed, who again have 20 days to evaluate the application.\n\nYou can change the application at %:application-url%"
                                 :subject-to-handler "EPKEB application %:application-id% – returned for changes"
                                 :message-to-handler "Dear %:recipient%,\n\n%:event-actor% has returned application %:application-id% for changes. The deadline of the changes is %:deadline%.\n\nThe application: %:application-url%"
                                 :subject-to-reviewer "EPKEB application %:application-id% – feedback from reviewers"
                                 :message-to-reviewer "Dear %:recipient%,\n\nFor your information: application %:application-id% has been returned for changes based on the reviews. The feedback sent to the applicant:\n\n%:comment%\n\nYou will be asked to review the revised application. The application: %:application-url%"}
          :application-revoked {:subject-to-applicant "Entitlements related to your application %:application-id% have been revoked"
                                :message-to-applicant "Dear %:recipient%,\n\nEntitlements related to your application %:application-id% have been revoked.\n\nYou can view the application at %:application-url%"
                                :subject-to-handler "(%:application-id%) Entitlements have been revoked"
                                :message-to-handler "Dear %:recipient%,\n\n%:event-actor% has revoked the entitlements related to application %:application-id% from %:applicant%.\n\nYou can view the application at %:application-url%"}
          :application-licenses-added {:subject "Your application's %:application-id% declarations have changed"
                                       :message "Dear %:recipient%,\n\n%:event-actor% has requested your approval for changed declarations to application %:application-id%.\n\nYou can view the application and approve the changed declarations at %:application-url%"}
          :application-resubmitted {:subject-to-handler "EPKEB application %:application-id% – revised application"
                                    :message-to-handler "Dear %:recipient%,\n\nThe revised version of application %:application-id% has arrived. Please ask the reviewers to review it again (with a 10-day deadline), or decide.\n\nThe application: %:application-url%"}
          :application-submitted {:subject-to-applicant "EPKEB application %:application-id% – submitted"
                                  :message-to-applicant "Dear %:recipient%,\n\nApplication %:application-id% has been submitted to the EPKEB. You will be notified by email of the result of the review.\n\nThe application: %:application-url%"
                                  :subject-to-handler "EPKEB application %:application-id% – new application"
                                  :message-to-handler "Dear %:recipient%,\n\n%:applicant% has submitted a new application (%:application-id%, %:catalogue-items%).\n\nThe application: %:application-url%"}
          :decided {:subject "(%:application-id%) Application decision notification"
                    :message "Dear %:recipient%,\n\n%:event-actor% has filed a decision on application %:application-id%, submitted by %:applicant%.\n\nYou can review the application at %:application-url%"}
          ;; Format parameters for decider-invited:
          ;; %1 - %:recipient% - name of recipient
          ;; %2 - %:applicant% - name of applicant
          ;; %3 - %:application-id% - id of application (+ description of application if available)
          ;; %4 - %:invitation-url% - invitation link
          :decider-invited {:subject "Invitation to participate in handling application %:application-id%"
                            :message "Dear %:recipient%,\n\nYou have been invited to participate in handling application %:application-id%, by %:applicant%.\n\nYou can view the application at %:invitation-url%"}
          :decision-requested {:subject "(%:application-id%) Decision request"
                               :message "Dear %:recipient%,\n\n%:event-actor% has requested your decision on application %:application-id%, submitted by %:applicant%.\n\nYou can review application at %:application-url%"}
          :footer "\n\nPlease do not reply to this automatically generated message."
          :handler-reminder {;; Format parameters for handler-reminder/application:
                             ;; %1 - %:applicant% - name of applicant
                             ;; %2 - %:application-id% - id of application (+ description of application if available)
                             :application "%:application-id%, submitted by %:applicant%"
                             ;; Format parameters for handler-reminder/message:
                             ;; %1 - %:recipient% - name of handler user
                             ;; %2 - %:applications% - list of applications which require action
                             ;; %3 - %:actions-url% - link to actions page
                             :message "Dear %:recipient%,\n\nThe following applications are in progress and may require your actions:\n\n%:applications%\n\nYou can view the applications at %:actions-url%"
                             :subject "Applications in progress"}
          :marked-ready {:subject "(%:application-id%) Application is ready for submission"
                         :message "Dear %:recipient%,\n\n%:event-actor% has marked the application %:application-id% ready for submission.\n\nYou can view and submit the application at %:application-url%"
                         :subject-to-supervisor "(%:application-id%) Application is waiting for your approval"
                         :message-to-supervisor "Dear %:recipient%,\n\n%:event-actor% has marked the application %:application-id% ready for submission. As its supervisor, please review and approve it; the application can be submitted only after your approval.\n\nYou can view and approve the application at %:application-url%"}
          :supervision-approved {:subject "(%:application-id%) The supervisor has approved the application"
                                 :message "Dear %:recipient%,\n\n%:event-actor% has approved the application %:application-id% as the supervisor.\n\nYou can view the application at %:application-url%"
                                 :subject-ready "(%:application-id%) Application is ready for submission"
                                 :message-ready "Dear %:recipient%,\n\n%:event-actor% has approved the application %:application-id% as the supervisor, and it has been marked ready for submission.\n\nYou can view and submit the application at %:application-url%"}
          :supervisor-designated {:subject "(%:application-id%) You have been designated as a supervisor"
                                  :message "Dear %:recipient%,\n\n%:event-actor% has designated you as the supervisor of the application %:application-id%. The application can be submitted only after your approval.\n\nYou can view and approve the application at %:application-url%"}
          :member-added {:subject "Added as a member of an application %:application-id%"
                         :message "Dear %:recipient%,\n\nYou've been added as a member of application %:application-id%, submitted by %:applicant%.\n\nYou can view application and accept the declarations at %:application-url%"}
          ;; Format parameters for member-invited:
          ;; %1 - %:recipient% - name of recipient
          ;; %2 - %:applicant% - name of applicant
          ;; %3 - %:application-id% - id of application (+ description of application if available)
          ;; %4 - %:invitation-url% - invitation link
          :supervisor-invited {:subject "Invitation to be the supervisor of application %:application-id%"
                               :message "Dear %:recipient%,\n\nYou have been invited to be the supervisor of application %:application-id%, by %:applicant%. As the supervisor, you approve the application before it is submitted.\n\nYou can view the application and accept the invitation at %:invitation-url%"}
          :member-invited {:subject "Invitation to participate in application %:application-id%"
                           :message "Dear %:recipient%,\n\nYou have been invited to participate in application %:application-id%, by %:applicant%.\n\nYou can view the application and accept the declarations at %:invitation-url%"}
          :regards "\n\nBest regards,\n\nEPKEB Secretariat\nUnited Ethical Review Committee for Research in Psychology\n"
          :remarked {:subject "(%:application-id%) Application has been commented"
                     :message "Dear %:recipient%,\n\n%:event-actor% has commented your application %:application-id%, submitted by %:applicant%.\n\nYou can view the application and the comment at %:application-url%"}
          :review-requested {:subject "EPKEB application %:application-id% – review request"
                             :message "Dear %:recipient%,\n\n%:event-actor% asks you to review application %:application-id%. The deadline of the review is %:deadline%.\n\nPlease let the chair know if you cannot review it by the deadline.\n\nThe application and the review form: %:application-url%"
                             :subject-re-review "EPKEB application %:application-id% – revised application"
                             :message-re-review "Dear %:recipient%,\n\nThe revised version of application %:application-id% has arrived. Please indicate in a new review whether you accept the changes or request further changes. The system highlights the changed answers.\n\nThe deadline of the review is %:deadline%.\n\nThe application: %:application-url%"}
          :reviewed {:subject "EPKEB application %:application-id% – a review has arrived"
                     :message "Dear %:recipient%,\n\n%:event-actor% has reviewed application %:application-id%.\n\nThe application: %:application-url%"
                     :subject-all-done "EPKEB application %:application-id% – the reviews have arrived"
                     :message-all-done "Dear %:recipient%,\n\nThe reviews of application %:application-id% have arrived, and the application is waiting for a decision. The recommendations are on the \"Reviews\" card of the application.\n\nThe application: %:application-url%"}
          ;; Format parameters for reviewer-invited:
          ;; %1 - %:recipient% - name of recipient
          ;; %2 - %:applicant% - name of applicant
          ;; %3 - %:application-id% - id of application (+ description of application if available)
          ;; %4 - %:invitation-url% - invitation link
          :reviewer-invited {:subject "Invitation to participate in handling application %:application-id%"
                             :message "Dear %:recipient%,\n\nYou have been invited to participate in handling application %:application-id%, by %:applicant%.\n\nYou can view the application at %:invitation-url%"}
          :reviewer-reminder {;; Format parameters for reviewer-reminder/application:
                              ;; %1 - %:applicant% - name of applicant
                              ;; %2 - %:application-id% - id of application (+ description of application if available)
                              :application "%:application-id%, submitted by %:applicant%"
                              ;; Format parameters for reviewer-reminder/message:
                              ;; %1 - %:recipient% - name of handler user
                              ;; %2 - %:applications% - list of applications which require action
                              ;; %3 - %:actions-url% - link to actions page
                              :message "Dear %:recipient%,\n\nThe following applications are waiting for a review from you:\n\n%:applications%\n\nYou can view the applications at %:actions-url%"
                              :subject "Applications pending review"}
          ;; Format parameters for workflow-handler-invitation:
          ;; %1 - %:recipient% - name of invited person, as entered in application
          ;; %2 - %:invited-by% - name of person who sent the invitation
          ;; %3 - %:workflow% - workflow title
          ;; %4 - %:invitation-url% - invitation link
          :workflow-handler-invitation {:message "Dear %:recipient%,\n\n%:invited-by% has invited you to be a handler of applications of workflow %:workflow%.\n\nYou can view the workflow at %:invitation-url%"
                                        :subject "Invitation to handle applications"}}
